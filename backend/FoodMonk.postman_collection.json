              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tables",
              "host": ["{{base_url}}"],
              "path": ["api", "tables"]
            }
          }
        },
        {
          "name": "Create Table",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"T-01\",\n  \"capacity\": 4,\n  \"location\": \"Window Side\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tables",
              "host": ["{{base_url}}"],
              "path": ["api", "tables"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Order Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "stats"]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\",\n  \"note\": \"Order confirmed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders/:orderId/status",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", ":orderId", "status"],
              "variable": [
                {
                  "key": "orderId",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Public (Customer)",
      "item": [
        {
          "name": "Get Table Menu",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/public/table/:tableUrl",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "table", ":tableUrl"],
              "variable": [
                {
                  "key": "tableUrl",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
