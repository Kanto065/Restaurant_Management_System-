              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableUrl\": \"your-table-url\",\n  \"items\": [\n    {\n      \"food\": \"foodId\",\n      \"quantity\": 2\n    }\n  ],\n  \"customerName\": \"John Doe\",\n  \"customerPhone\": \"+8801712345678\",\n  \"paymentMethod\": \"cash\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/public/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "orders"]
            }
          }
        }
      ]
    }
  ]
}
