<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required by targetSdk 34 to run OrderListenerService as a dataSync foreground service,
         and to actually show its "listening for orders" notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sunmi's built-in printer is driven through their system-bound AIDL service, not a
         standard Android print API - no extra runtime permission needed for it. -->
    <!-- Lets UpdateChecker's install Intent run without going through Play/a market app -
         required on API 26+ to sideload the APK it downloads from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PosApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PosApp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PosApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the SSE connection + print queue alive while the app is backgrounded, which
             matters on a POS terminal that's expected to receive orders continuously. -->
        <service
            android:name=".data.network.OrderListenerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hands the system package installer a content:// Uri for the APK UpdateChecker
             downloads into cacheDir - a file:// Uri would be blocked by FileUriExposedException
             on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_apk_paths" />
        </provider>

    </application>
</manifest>
