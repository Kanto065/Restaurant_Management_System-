<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes only the cache dir, where UpdateChecker writes the downloaded APK, to the system
     package installer via FileProvider - nothing else in the app's storage is shared. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="./" />
</paths>
