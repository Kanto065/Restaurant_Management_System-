{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=platform;Username=platform;Password=CHANGE_ME_IN_LOCAL_SETTINGS",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "https://api.porttennanttandoori.co.uk",
    "Audience": "porttennanttandoori-clients",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_IN_LOCAL_SETTINGS_OR_ENV",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "DeviceAccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.porttennanttandoori.co.uk",
      "https://admin.porttennanttandoori.co.uk",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  }
}
