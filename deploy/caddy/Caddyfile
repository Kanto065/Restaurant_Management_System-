# Phase 1 topology: explicit hosts, standard automatic HTTPS (Let's Encrypt).
# Revisit with on-demand TLS (see plan doc §7) once Phase 5 self-service tenant
# onboarding lands and domains are no longer known ahead of time in this file.

{$API_HOST} {
	reverse_proxy api:8080
}

{$ADMIN_HOST} {
	reverse_proxy admin-frontend:80
}

{$STOREFRONT_HOST} {
	# /api (including /api/events, the SSE stream) stays on this same domain and
	# proxies straight to the API container, so the tenant-resolution middleware
	# sees the real customer domain as the Host header (not a shared platform
	# api.* host) and can resolve the tenant via the Domain table. Caddy detects
	# text/event-stream responses and disables buffering automatically, so SSE
	# needs no special config here. Everything else is the static SPA.
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy storefront:80
	}
}
