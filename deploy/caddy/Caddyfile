# Phase 1 topology: explicit hosts, standard automatic HTTPS (Let's Encrypt).
# Revisit with on-demand TLS (see plan doc §7) once Phase 5 self-service tenant
# onboarding lands and domains are no longer known ahead of time in this file.

# Bare apex domain has no A record history of its own content - redirect to the
# canonical www host instead of duplicating the storefront site block, so there's
# only ever one indexable URL per page.
{$APEX_HOST} {
	redir https://{$STOREFRONT_HOST}{uri} permanent
}

{$API_HOST} {
	# Admin-uploaded images (hero slides, logo, etc) live in the MinIO "uploads"
	# bucket, not the api container - the bucket's public-read policy plus
	# path-style S3 addressing means GET /uploads/{key} on MinIO IS the object,
	# so this proxies straight there instead of through the API.
	handle /uploads/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy api:8080
	}
}

{$ADMIN_HOST} {
	# Stable "download the POS app" link (see Devices.tsx) - android-release.yml re-uploads
	# pos/porttennanttandoori-pos.apk to the same key on every build touching android/**, so this
	# always serves the latest one without the link itself ever changing.
	handle /download/pos {
		rewrite * /uploads/pos/porttennanttandoori-pos.apk
		reverse_proxy minio:9000
	}
	# UpdateChecker polls this instead of GitHub's Releases API - works the same whether this
	# repo is public or private, since it never touches GitHub at runtime.
	handle /download/pos-version {
		rewrite * /uploads/pos/version.json
		reverse_proxy minio:9000
	}
	# Same-origin API + uploads, like the storefront block: the admin build calls /api on
	# whatever admin domain it's served from, and the API resolves the restaurant from that
	# Host (a Domain row with Kind=Admin), so one admin build serves every restaurant.
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /uploads/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy admin-frontend:80
	}
}

{$STOREFRONT_HOST} {
	# /api (including /api/events, the SSE stream) stays on this same domain and
	# proxies straight to the API container, so the tenant-resolution middleware
	# sees the real customer domain as the Host header (not a shared platform
	# api.* host) and can resolve the tenant via the Domain table. Caddy detects
	# text/event-stream responses and disables buffering automatically, so SSE
	# needs no special config here. Everything else is the static SPA.
	handle /api/* {
		reverse_proxy api:8080
	}
	# Admin-uploaded images are referenced as relative /uploads/... URLs in
	# storefront content, so they need the same same-origin proxy treatment as
	# /api/* - straight to MinIO, same as the API_HOST block above.
	handle /uploads/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy storefront:80
	}
}

# Platform owner's super admin panel. No Domain row points here, so the API resolves no
# tenant for it and only /api/platform/* (PlatformSuperAdmin tokens) is useful. Protected by
# the app's own login (only users flagged IsPlatformSuperAdmin get a platform token).
{$SUPERADMIN_HOST} {
	header X-Robots-Tag "noindex, nofollow"
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy superadmin-frontend:80
	}
}

# ---------------------------------------------------------------------------------------
# Star Spice (second tenant, starspicetumble.co.uk). Same API/MinIO as Port Tennant - the API
# resolves the restaurant from each Host (Domain rows created in the super admin panel).
# ---------------------------------------------------------------------------------------

# Storefront is public ("opening soon"). noindex stays until launch; the other headers mirror
# the client's dist/_headers.
(starspice_storefront) {
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	handle /api/* {
		reverse_proxy {args[0]}:8080
	}
	handle /uploads/* {
		reverse_proxy {args[1]}:9000
	}
	handle {
		reverse_proxy {args[2]}:80
	}
}

(tenant_admin) {
	handle /api/* {
		reverse_proxy {args[0]}:8080
	}
	handle /uploads/* {
		reverse_proxy {args[1]}:9000
	}
	handle {
		reverse_proxy {args[2]}:80
	}
}

{$STARSPICE_HOST} {
	import starspice_storefront api minio storefront-starspice
}

www.{$STARSPICE_HOST} {
	redir https://{$STARSPICE_HOST}{uri} permanent
}

{$STARSPICE_ADMIN_HOST} {
	import tenant_admin api minio admin-frontend
}

{$STARSPICE_UAT_HOST} {
	import starspice_storefront uat-api uat-minio uat-storefront-starspice
}

{$STARSPICE_ADMIN_UAT_HOST} {
	import tenant_admin uat-api uat-minio uat-admin-frontend
}

# UAT copy of the super admin panel (talks to the UAT API only).
{$SUPERADMIN_UAT_HOST} {
	header X-Robots-Tag "noindex, nofollow"
	handle /api/* {
		reverse_proxy uat-api:8080
	}
	handle {
		reverse_proxy uat-superadmin-frontend:80
	}
}

# UAT - fully separate Postgres/MinIO/api/admin-frontend/storefront stack
# (docker-compose.uat.yml), reached over the shared "edge" external network since
# this Caddy instance is the only thing on the VPS allowed to bind 80/443. See
# deploy/README.md "UAT environment" for how that network is wired up.
{$STOREFRONT_UAT_HOST} {
	handle /api/* {
		reverse_proxy uat-api:8080
	}
	handle /uploads/* {
		reverse_proxy uat-minio:9000
	}
	handle {
		reverse_proxy uat-storefront:80
	}
}

{$ADMIN_UAT_HOST} {
	handle /api/* {
		reverse_proxy uat-api:8080
	}
	handle /uploads/* {
		reverse_proxy uat-minio:9000
	}
	handle {
		reverse_proxy uat-admin-frontend:80
	}
}

{$API_UAT_HOST} {
	handle /uploads/* {
		reverse_proxy uat-minio:9000
	}
	handle {
		reverse_proxy uat-api:8080
	}
}

# Per-project site files that live outside this repo so deploys here cannot overwrite them.
# Host folder /opt/caddy-sites.d is mounted at /etc/caddy/sites.d (see docker-compose.prod.yml).
import /etc/caddy/sites.d/*.caddy
