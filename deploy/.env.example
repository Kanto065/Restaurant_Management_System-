# Copy to deploy/.env on the VPS and fill in real values. Never commit the real .env file.

POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

JWT_ISSUER=https://api.porttennanttandoori.co.uk
JWT_AUDIENCE=porttennanttandoori-clients
JWT_SIGNING_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

API_HOST=api.porttennanttandoori.co.uk
ADMIN_HOST=admin.porttennanttandoori.co.uk
STOREFRONT_HOST=www.porttennanttandoori.co.uk

SEED_ENABLED=true
SEED_HOST=www.porttennanttandoori.co.uk
SEED_OWNER_EMAIL=owner@porttennanttandoori.co.uk
SEED_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO (S3-compatible object store for uploaded images) - required, the api
# container reuses these as its Storage__S3__AccessKey/SecretKey. If MinIO
# boots with an empty/invalid root user or password it will refuse to start
# (or the api container will get auth rejections on every upload), so image
# uploads across the whole site silently fail without these set.
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
